# AI Execution OS Configuration Example

# Database & Storage
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/execution_os
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/execution_os_test
REDIS_URL=redis://redis:6379/0

# LLM Providers (Zero Paid Dependencies)
ACTIVE_LLM_PROVIDER=ollama   # options: ollama, groq, gemini
ACTIVE_LLM_MODEL=llama3.2    # options: llama3.2, llama3-8b-8192, gemini-1.5-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434

# API Keys (Optional Free Tiers)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Embeddings (Local & Zero API Cost)
ACTIVE_EMBEDDING_PROVIDER=ollama  # options: ollama, huggingface
EMBEDDING_DIMENSION=768            # 768 for nomic-embed-text, 384 for all-MiniLM-L6-v2

# Observability (Optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=execution-os
LANGCHAIN_TRACING_V2=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
